  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IdleBlacksmith.UI.IntroCinematic
  group: {fileID: 2091870308}
  artImage: {fileID: 1689000255}
  barTop: {fileID: 362940228}
  barBottom: {fileID: 298037634}
  captionLabel: {fileID: 176408042}
  captionGroup: {fileID: 176408041}
  skipButton: {fileID: 127772419}
  advanceButton: {fileID: 250405139}
  pageLabel: {fileID: 1912556667}
  tapHint: {fileID: 1870823603}
  frames:
  - art: {fileID: 21300000, guid: f4425e8a94bc7fc6cba8d79cfeb0fa0b, type: 3}
    caption: The village of Emberhold had gone quiet. The forge that once lit the
      valley burned out generations ago.
  - art: {fileID: 21300000, guid: 99328148ed3f50f0b8701d61f30ef4eb, type: 3}
    caption: "But on the longest night, a single ember fell from the old hearth \u2014
      and landed in waiting hands."
  - art: {fileID: 21300000, guid: 4881e0bf83f95bbda9232c5458c6d448, type: 3}
    caption: '"I swear it," the smith whispered. "Iron will sing again. The racks
      will fill. The gate will open."'
  - art: {fileID: 21300000, guid: 0be8c0f063c97387883213c2f8b47f3c, type: 3}
    caption: And so the forge woke. This is where your legend begins.
  secondsPerFrame: 6.5
  charsPerSecond: 48
  barHeight: 150
  zoomFrom: 1
  zoomTo: 1.08
  barSeconds: 0.9
