  m_Script: {fileID: 11500000, guid: 2c9464d798088804f98717c9817be36b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IdleBlacksmith.UI.OnboardingPanel
  group: {fileID: 1516655645}
  card: {fileID: 654964911}
  artImage: {fileID: 1392886515}
  artFitter: {fileID: 1392886512}
  titleLabel: {fileID: 2039356110}
  bodyLabel: {fileID: 2023021879}
  dots:
  - {fileID: 408309497}
  - {fileID: 360878894}
  - {fileID: 225802015}
  - {fileID: 324712120}
  - {fileID: 1604996714}
  nextButton: {fileID: 1174119066}
  nextLabel: {fileID: 1009013415}
  skipButton: {fileID: 472964989}
  pages:
  - art: {fileID: 21300000, guid: 0a8896abdcbc0714388630343d37e166, type: 3}
    title: Forge Legendary Swords
    body: "Miners dig ore, your smith hammers it on the anvil, and the rack fills
      up with swords. Every blade rolls its own quality \u2014 from Common all the
      way to Legendary."
  - art: {fileID: 21300000, guid: 3cf576b3060f5574cbac4c66d306e692, type: 3}
    title: Feed the Forge
    body: Ore is the fuel of the whole workshop. Raise the Ore Mine so the pile keeps
      growing, even while the app is closed.
  - art: {fileID: 21300000, guid: e143d773f5cae89479a23162fa6d545e, type: 3}
    title: Sell at the Counter
    body: "Customers walk the path and buy the best sword on your rack \u2014 better
      quality, better pay. Gold buys upgrades, and upgrades buy better swords."
  - art: {fileID: 21300000, guid: 0a8896abdcbc0714388630343d37e166, type: 3}
    title: Look Around
    body: "Drag the yard to pan, pinch to zoom, and double-tap to snap back to the
      forge. Tap the marked plots \u2014 or the COMPLEX button \u2014 to raise a
      new building."
  - art: {fileID: 21300000, guid: 31c2fc7010c343a4a9321bbbf7593aa0, type: 3}
    title: Raid the Dungeons
    body: Send adventurers through the Dungeon Gate. They return with gold and relic
      ore, and the run finishes even while you are away.
  - art: {fileID: 21300000, guid: 57d0cec3e0ca0244ca71b4c812e15a0c, type: 3}
    title: Rekindle the Forge
    body: When the complex is running at full tilt, burn the run for ember shards.
      Talents are permanent, so every rekindle makes the next forge stronger.
